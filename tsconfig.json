{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@bydtech/site-agent": ["./src/index.ts"],
      "@bydtech/site-agent/server": ["./src/server.ts"],
      "@bydtech/site-agent/element": ["./src/element.ts"]
    }
  },
  "include": ["src", "test", "examples/*.ts", "tsup.config.ts", "vitest.config.ts"]
}
